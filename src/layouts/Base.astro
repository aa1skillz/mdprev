---
import '@fontsource/be-vietnam-pro/latin-400.css';
import '@fontsource/be-vietnam-pro/latin-500.css';
import '@fontsource/be-vietnam-pro/vietnamese-400.css';
import '@fontsource/be-vietnam-pro/vietnamese-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/vietnamese-400.css';
import '@fontsource/jetbrains-mono/vietnamese-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import Shell from '../components/islands/Shell';
import Palette from '../components/islands/Palette';
import { KEYS } from '../lib/storage';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  /** Loại trang: app, markdown-popout, markdown-presenter, page. */
  view?: string;
  /** Có nạp Shell + Palette không (cửa sổ phụ không cần). */
  shell?: boolean;
  /** Tiêu đề đầy đủ, thay cho "<title> · mdprev" (trang chủ dùng tiêu đề riêng). */
  titleFull?: string;
  /** Ảnh xem trước khi chia sẻ (đường dẫn trong site). Mặc định /og.png. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Dữ liệu có cấu trúc (JSON-LD), mỗi phần tử một khối. Chỉ đưa vào dữ liệu có thật trên trang. */
  jsonLd?: object[];
}
const NAME = 'mdprev';
const { title, description = 'Markdown editor in your browser.', path = Astro.url.pathname, noindex = false, view = 'page', shell = true, titleFull, ogImage = '/og.png', ogType = 'website', jsonLd = [] } = Astro.props;
const fullTitle = titleFull ?? (title ? `${title} · ${NAME}` : NAME);
const canonical = new URL(path, Astro.site ?? 'http://localhost').toString();
const ogAbs = new URL(url(ogImage), Astro.site ?? 'http://localhost').toString();
// JSON-LD nằm trong <script>: thoát "<" để chuỗi nào cũng không thể đóng thẻ sớm.
const ld = jsonLd.map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181613" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={url('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('/app/icons/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url('/app/icons/apple-180.png')} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="mdprev: a quiet Markdown editor and agent skill inspector" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
    <script is:inline define:vars={{ themeKey: KEYS.theme }}>
      // Áp dụng giao diện trước khi vẽ để không bị nháy. Cùng khóa với src/lib/storage.ts.
      // Quy tắc phải khớp resolveTheme (src/lib/prefs.ts): lựa chọn đã lưu thắng, chưa lưu thì theo hệ điều hành.
      try {
        var r = document.documentElement;
        var stored = localStorage.getItem(themeKey);
        var os = matchMedia('(prefers-color-scheme: dark)');
        r.dataset.theme = stored === 'dark' || stored === 'light' ? stored : os.matches ? 'dark' : 'light';
        r.dataset.themeSource = stored === 'dark' || stored === 'light' ? 'chosen' : 'system';
        // Hệ điều hành đổi sáng/tối khi trang đang mở: chỉ theo nếu người dùng chưa chọn.
        os.addEventListener('change', function (e) {
          var s = localStorage.getItem(themeKey);
          if (s !== 'dark' && s !== 'light') r.dataset.theme = e.matches ? 'dark' : 'light';
        });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.dataset.alive = 'calm';
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body data-view={view}>
    <div class="shell">
      <div class="frame">
        <main class="main" id="main"><slot /></main>
      </div>
    </div>
    {shell && <Shell client:idle />}
    {shell && <Palette client:idle />}
  </body>
</html>

<style is:global>
  body { font-family: 'Be Vietnam Pro', system-ui, sans-serif; }
  html { -webkit-tap-highlight-color: transparent; }
  a, button, summary, input, select, textarea, [role='button'] { touch-action: manipulation; }
  .shell { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; background: var(--bg); color: var(--ink); }
  .frame { flex: 1; width: 100%; max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; }
  .main { flex: 1; }
</style>
