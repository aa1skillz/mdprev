---
import Page from '../layouts/Page.astro';
import { url } from '../lib/url';
---
<Page title="Page not found" description="This page does not exist." path="/404.html" noindex>
  <article class="art">
    <span class="st-lbl">404</span>
    <h1>This page does not exist</h1>
    <p>The link may be old or mistyped. Nothing was lost: your documents live in your browser, not on this page.</p>
    <p><a href={url('/app/')}>Open the editor</a> · <a href={url('/skill-inspector/')}>Skill inspector</a> · <a href={url('/guides/')}>Guides</a></p>
  </article>
</Page>
