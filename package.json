{
  "name": "mdprev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A quiet Markdown editor and an inspector for agent skills (SKILL.md). Free, in your browser, nothing uploaded.",
  "homepage": "https://mdprev.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa1skillz/mdprev.git"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node tools/sw-precache.mjs && node tools/csp.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm astro check && pnpm test && pnpm build",
    "serve": "node tools/serve-dist.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/preact": "^6.1.2",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "astro": "^7.4.7",
    "docx": "9.15.3",
    "hast-util-from-html": "^2.1.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "preact": "^11.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "fake-indexeddb": "^6.2.8",
    "fflate": "0.8.3",
    "mammoth": "^1.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.3",
      "micromark-extension-math>katex": "^0.19.1"
    }
  }
}
